    "demo:historial": "tsx src/demos/historial.ts",
    "demo:back": "tsx src/demos/back-visual.ts",
    "demo:aislamiento": "tsx src/demos/aislamiento.ts",
    "demo:keys": "tsx src/demos/keys.ts",
    "demo:menciones": "tsx src/demos/menciones.ts",
    "demo:interrupcion": "tsx src/demos/interrupcion.ts",
    "demo:agentes-se-ven": "tsx src/demos/agentes-se-ven.ts",
